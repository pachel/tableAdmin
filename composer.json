{
    "name": "pachel/tableadmin",
    "description": "Table content editor",
    "repositories": [{
        "type": "path",
        "url": "../dbclass",
        "canonical": false,
        "options": {
            "symlink": true
        }
    }],
    "require": {

        "pachel/dbclass": "dev-master",
        "pachel/functions": "dev-master"
    },
    "autoload": {      
        "classmap": ["src/"],
        "files" : ["inc/errors.php","src/functions.php"]
    },
    "require-dev": {
        "twbs/bootstrap": "^5.3",
        "datatables/datatables": "^1.10",
        "components/jquery": "^4.0"
    }
}
